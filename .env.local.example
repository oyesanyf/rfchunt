# ==============================================================================
# RFCHunt Paid / Enterprise LLM Model Configuration (.env.local)
# ==============================================================================
# Copy this file to `.env.local` (gitignored) and uncomment ONE OR MORE paid
# providers. Whenever `.env.local` configures a valid paid model/API key,
# RFCHunt automatically routes ModelFusionAdapter, FusionArbiter, Mantis,
# RAPTOR, TieredModelRouter, and Auto-Repair to those paid models and SKIPS
# all local Ollama daemon probes, auto-starts, and model pulls.
#
# Leave `.env.local` absent (or set RFCHUNT_USE_PAID_MODELS=0 / --force-ollama)
# to run 100% locally via Ollama at zero API cost.
# ==============================================================================

# Optional master toggle (defaults to auto-enabled whenever paid keys exist in .env.local)
# RFCHUNT_USE_PAID_MODELS=1

# Optional explicit default provider: anthropic | openai | azure_openai | gemini | openrouter | openai_compatible
# RFCHUNT_PAID_PROVIDER=anthropic

# ------------------------------------------------------------------------------
# 1. Anthropic Claude
# ------------------------------------------------------------------------------
# ANTHROPIC_API_KEY=REPLACE_ME
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2023-06-01

# ------------------------------------------------------------------------------
# 2. OpenAI or OpenAI-Compatible Enterprise Gateway (LiteLLM, Corporate Proxy, etc.)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=REPLACE_ME
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 3. Azure OpenAI
# ------------------------------------------------------------------------------
# AZURE_OPENAI_API_KEY=REPLACE_ME
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-10-21

# ------------------------------------------------------------------------------
# 4. Google Gemini API
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=REPLACE_ME
# GEMINI_MODEL=gemini-2.5-pro
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ------------------------------------------------------------------------------
# 5. OpenRouter (Multi-Vendor Paid Gateway)
# ------------------------------------------------------------------------------
# OPENROUTER_API_KEY=REPLACE_ME
# OPENROUTER_MODEL=anthropic/claude-3.7-sonnet
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# 6. Optional Multi-Model Paid Panel Role Assignment
#    (Mix multiple providers configured above in one ModelFusion consensus panel)
# ------------------------------------------------------------------------------
# RFCHUNT_PAID_MODELS=claude-sonnet-4-20250514,gpt-4o,gemini-2.5-pro
# RFCHUNT_PAID_PRIMARY_MODEL=claude-sonnet-4-20250514
# RFCHUNT_PAID_SEC_MODEL=gpt-4o
# RFCHUNT_PAID_ARBITER_MODEL=gemini-2.5-pro
# RFCHUNT_PAID_TIMEOUT=120.0

# ------------------------------------------------------------------------------
# 7. Optional Hybrid Local Ollama + Cloud Panel (Mix zero-cost local specialists
#    with a cloud reasoning arbiter without bypassing Ollama)
# ------------------------------------------------------------------------------
# RFCHUNT_HYBRID_PANEL=1
# RFCHUNT_PAID_MODELS=ollama/qwen2.5:1.5b,ollama/deepseek-r1:1.5b,anthropic/claude-sonnet-4-20250514
# RFCHUNT_PAID_PRIMARY_MODEL=ollama/qwen2.5:1.5b
# RFCHUNT_PAID_SEC_MODEL=ollama/deepseek-r1:1.5b
# RFCHUNT_PAID_ARBITER_MODEL=anthropic/claude-sonnet-4-20250514
